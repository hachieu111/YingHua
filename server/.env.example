# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit .env.
ENV=dev
DATABASE_URL=postgresql+asyncpg://postgres:<mat_khau>@localhost:5432/yinghua_db
TEST_DATABASE_URL=postgresql+asyncpg://postgres:<mat_khau>@localhost:5432/yinghua_test
JWT_SECRET=<chuoi_ngau_nhien_toi_thieu_32_ky_tu>
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=["http://localhost:3000"]
STORAGE_DIR=storage
LOG_LEVEL=INFO
LOG_JSON=false
FRONTEND_URL=http://localhost:3000
# Pipeline xử lý ảnh (worker). false = worker không nhận việc.
PIPELINE_ENABLED=false
# Tài nguyên pipeline (mặc định trỏ vào `module xử lí ảnh/`; đường dẫn tương đối tính từ server/).
# PIPELINE_DIR=
# YOLO_MODEL_PATH=
# FONT_DIR=
# XIANXIA_DICT_DIR=
WORKER_POLL_SECONDS=3.0
JOB_MAX_ATTEMPTS=2
JOB_STALE_MINUTES=15
GUEST_LOOKUP_LIMIT=5
GUEST_SESSION_HOURS=24
# M11 Phát âm: false = tạm tắt TTS (trả 503 TTS_DISABLED). Thời gian chờ Edge TTS mặc định 10 giây.
TTS_ENABLED=true
# M09 Kiểm tra: false = luôn dùng đề dự phòng từ từ điển (chưa chọn nhà cung cấp LLM). Chờ LLM tối đa 20 giây.
LLM_ENABLED=false
LLM_TIMEOUT_SECONDS=20
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-flash-lite-latest
LLM_THINKING_LEVEL=low
QUIZ_QUESTION_COUNT=10
QUIZ_MIN_WORDS=10
QUIZ_DAILY_LLM_LIMIT=5
AI_NOTE_DAILY_LIMIT=20
AI_NOTE_REGENERATE_LIMIT=3
